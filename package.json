{
  "name": "anonymous-chat",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n backend,frontend \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "check": "npm run check --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start -w backend",
    "preview": "npm run preview -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
